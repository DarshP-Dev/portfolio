# Optional verified canonical origin. Leave blank until the domain is confirmed.
VITE_SITE_URL=
# Explicit publication opt-in. Requires a verified HTTPS origin and drafts excluded.
# Vercel preview/development deployments always remain noindex.
VITE_SITE_INDEXABLE=false
# Only an approved PDF in public/resume. Change the filename here if needed, then rebuild.
VITE_RESUME_PATH=/resume/Darsh_Patel_Resume.pdf
# Review build: include clearly labeled draft project pages. Set false to omit them.
VITE_INCLUDE_DRAFTS=true
VITE_ENABLE_SIGNATURE_INTRO=false
# Review the intro at /?intro=preview before enabling it on the homepage.
# Review builds remain noindex until publication is explicitly enabled.

# Contact delivery: server-only. Never prefix credentials with VITE_.
# Leave disabled until provider, sending domain and durable spam controls are configured.
CONTACT_ENABLED=false
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=darshpatel060106@gmail.com
# Comma-separated exact origins, without trailing slashes; include the verified site origin.
CONTACT_ALLOWED_ORIGINS=
# Durable rate-limit storage. No raw IPs, emails or message bodies are stored here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Random secret of at least 32 characters for identifier hashing and idempotency keys.
CONTACT_HASH_SECRET=
# Explicit opt-in for a deliberate local delivery test; production does not use this flag.
CONTACT_ALLOW_LOCAL_DELIVERY=false
